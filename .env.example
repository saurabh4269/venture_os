# Copy to .env. Never commit secrets.

NODE_ENV=development
LOG_LEVEL=info

# Web
WEB_URL=http://localhost:3000
WEB_PORT=3000
# Leave empty so the browser uses same-origin /api (Next BFF → API_URL).
# Set only for a split host without the BFF (then cookies need SameSite=None).
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WEB_URL=http://localhost:3000
# Preview hosts, comma-separated. Better Auth + CORS + mutating Origin check.
WEB_ORIGIN_PATTERNS=https://*.vercel.app
# 1 to force Secure cookies; 0 to force off. Default: https BETTER_AUTH_URL or production.
COOKIE_SECURE=
GIT_SHA=

# API
API_PORT=4000
API_URL=http://localhost:4000

# Better Auth — generate a 32+ char secret for any live deploy
BETTER_AUTH_SECRET=dev-only-change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:4000

# Postgres — migrate as the image superuser; the app uses venture_os_app (no BYPASSRLS).
MIGRATE_DATABASE_URL=postgres://venture:venture@localhost:5432/venture_os
DATABASE_URL=postgres://venture_os_app:venture@localhost:5432/venture_os

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# S3-compatible object store.
# Compose MinIO: http://localhost:9000
# Native / tests without MinIO: S3_ENDPOINT=fs  (local ./uploads)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=venture-os
S3_ACCESS_KEY=venture
S3_SECRET_KEY=venturesecret
S3_FORCE_PATH_STYLE=true

# LLM — optional. Ask still refuses without evidence if unset.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_PROVIDER=openai

# Opt-in labelled fixtures only. Never set in production.
SEED_DEMO=0
SEED_DEMO_EMAIL=analyst@fixture.local
SEED_DEMO_PASSWORD=fixture-only-password

# Connectors — optional. Leave empty until you have real keys.
# Per-org paste is AES-256-GCM (ciphertext + nonce + key_version). Key stays in env, never in Postgres.
# Prefer CONNECTOR_SECRETS_KEY. Fallbacks: CONNECTOR_SEAL_SECRET, then BETTER_AUTH_SECRET.
# Env MICROSOFT_* / AFFINITY_API_KEY / GRANOLA_API_KEY are single-tenant fallbacks only (not copied to org_settings).
# Docs: docs/connectors/ADDING_KEYS.md and docs/connectors/SECURITY.md
CONNECTOR_SECRETS_KEY=
CONNECTOR_SECRETS_KEY_PREVIOUS=
CONNECTOR_SECRETS_KEY_VERSION=1
CONNECTOR_SEAL_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
AFFINITY_API_KEY=
GRANOLA_API_KEY=
